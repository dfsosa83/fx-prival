# Control file — the emergency stop is a state switch, not a data artifact.
# Never commit: committing it would arm the kill switch on a fresh clone.
data/emergency_stop.txt

# Transient executor state (session equity anchor, consecutive-loss counter).
# Regenerated on the first run of the next session.
executor_state.json

