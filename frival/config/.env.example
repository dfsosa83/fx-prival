# Copy to frival/config/.env and fill in. This file is gitignored — credentials
# and the terminal path never travel between machines through git.
#
# The autonomous trading path (order_executor, log_trade, counterfactual,
# market_context, reconcile_deals) does NOT read credentials: it attaches to
# the MT5 terminal that is already running and logged in. It reads ONLY
# MT5_PATH from here, and only as a fallback — if MT5_PATH is unset the path
# is auto-detected. See frival/mt5_path.py.
#
# MT5_LOGIN/PASSWORD/SERVER are used by data/fetcher.py for the legacy signal
# pipeline. If you do not run that pipeline you can leave them blank.

MT5_LOGIN=81486396
MT5_PASSWORD=your_password
MT5_SERVER=FPMarketsSC-Live

# Full path to terminal64.exe on THIS machine. Leave blank to auto-detect.
# The path differs between installs — note the space in "FP Markets":
#   C:\Program Files\FP Markets MT5 Terminal\terminal64.exe
#   C:\Program Files\FPMarkets MT5 Terminal\terminal64.exe
MT5_PATH=

OPENROUTER_API_KEY=your_openrouter_key
PERPLEXITY_API_KEY=your_perplexity_key
