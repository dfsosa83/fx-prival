# MT5 Order Execution Bot — Credentials
# Copy to credentials.env and fill in your values.
# credentials.env is gitignored — never commit real credentials.

# MT5 Account
MT5_LOGIN=81486396
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=FPMarketsSC-Live

# Demo overrides (uncomment to use demo account)
# MT5_LOGIN=7387548
# MT5_PASSWORD=u#wWU#64esZjNVn
# MT5_SERVER=FPMarketsSC-Demo

# MT5 terminal path (auto-detected if omitted)
MT5_TERMINAL_PATH=C:/Program Files/FPMarkets MT5 Terminal/terminal64.exe

# Enable to force demo-only mode regardless of MT5 account type
DEMO_MODE=true

# Emergency stop — set to true to prevent ALL order execution
EMERGENCY_STOP=false

# Logging
LOG_LEVEL=INFO

# Risk limits (overrides settings.yaml if set)
MAX_DAILY_TRADES=5
MAX_DAILY_LOSS=50.0